# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Important: If your MongoDB password contains special characters like <, >, @, #, etc.,
# you must URL-encode them. For example: < becomes %3C, > becomes %3E, @ becomes %40
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/stockqr?retryWrites=true&w=majority

# Authentication
# Use a strong, random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-with-a-long-random-string

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Application Metadata
APP_NAME=StockQR
APP_VERSION=1.0.0
